{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "firestore.rules",
   "README.md",
   ".github/**",
   "**/.*",
   "**/node_modules/**"
  ],
  "headers": [
   {
    "source": "**/*.@(js|css|html)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "**",
    "headers": [
     {
      "key": "X-Content-Type-Options",
      "value": "nosniff"
     },
     {
      "key": "X-Frame-Options",
      "value": "DENY"
     },
     {
      "key": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
     },
     {
      "key": "Permissions-Policy",
      "value": "camera=(), microphone=(), geolocation=()"
     },
     {
      "key": "Strict-Transport-Security",
      "value": "max-age=31536000; includeSubDomains"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 }
}